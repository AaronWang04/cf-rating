{
  "manifest_version": 3,
  "name": "Codeforces Rating & Dark Mode",
  "version": "1.2.0",
  "description": "Adds optional problem ratings plus dark and OLED themes to Codeforces.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Codeforces features",
    "default_popup": "popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cf-rating@aaronw.dev",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/*"
      ],
      "js": [
        "src/settings.js",
        "src/theme.js"
      ],
      "css": [
        "src/dark.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://codeforces.com/contest/*/problem/*",
        "https://codeforces.com/problemset/problem/*/*"
      ],
      "js": [
        "src/settings.js",
        "src/core.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
